p;cacheVersion=3D1&amp;api=3Dv2" data-height=3D"614" data-width=3D"802" dat=
a-unresolved-comment-count=3D"0" data-linked-resource-id=3D"3139796997" dat=
a-linked-resource-version=3D"1" data-linked-resource-type=3D"attachment" da=
ta-linked-resource-default-alias=3D"image-20220408-150208.png" data-base-ur=
l=3D"https://sharpencx.atlassian.net/wiki" data-linked-resource-content-typ=
e=3D"image/png" data-linked-resource-container-id=3D"3004301360" data-linke=
