ntainer-version=3D"7" data-media-id=3D"52f5260f-3020-4154-b6ed-17a0cdcb5379=
" data-media-type=3D"file" width=3D"468" height=3D"104"></span>
<p></p></li>
<li>
<p>Select the Update Queue Member Action from the Add Action drop down.<br>=
</p><span class=3D"confluence-embedded-file-wrapper image-center-wrapper"><=
img class=3D"confluence-embedded-image image-center" loading=3D"lazy" src=
=3D"382d91bdbaa033ccd93fbb5b38b78f2963a038ec513a24a1acf9792937d1d5e5" data-=
image-src=3D"https://sharpencx.atlassian.net/wiki/download/attachments/1031=
536666/vcbxHVHSl8Fj_mvQ8NL1wyr0wHWcvlzlaBaQXxC3Ft-bNHfqr5hRg4593Ju7SgDNRC1G=
UAzDBSWlw70lZ986Cjr7dAnSEEBFm-jXRq3ZZyDUWVN6XAClMNrj1SBuI4wLeQ?version=3D1&=
amp;modificationDate=3D1586544848238&amp;cacheVersion=3D1&amp;api=3Dv2" dat=
a-height=3D"68" data-width=3D"906" data-unresolved-comment-count=3D"0" data=
-linked-resource-id=3D"1033109572" data-linked-resource-version=3D"1" data-=
