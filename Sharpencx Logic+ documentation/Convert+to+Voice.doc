onDate=3D1730211205943&amp;cacheVersion=3D1&amp;api=3Dv2" data-height=3D"70=
7" data-width=3D"313" data-unresolved-comment-count=3D"0" data-linked-resou=
rce-id=3D"4243554313" data-linked-resource-version=3D"1" data-linked-resour=
ce-type=3D"attachment" data-linked-resource-default-alias=3D"Screenshot 202=
4-10-29 at 7.10.49=E2=80=AFAM-20241029-141314.png" data-base-url=3D"https:/=
/sharpencx.atlassian.net/wiki" data-linked-resource-content-type=3D"image/p=
ng" data-linked-resource-container-id=3D"4243914753" data-linked-resource-c=
ontainer-version=3D"1" data-media-id=3D"082896f5-87cd-4634-8dea-069d28f1623=
1" data-media-type=3D"file" height=3D"704"></span>
<p></p>
</div>
</div>
</div>
</div>
    </div>
</body>
