onDate=3D1730146251306&amp;cacheVersion=3D1&amp;api=3Dv2" data-height=3D"39=
6" data-width=3D"130" data-unresolved-comment-count=3D"0" data-linked-resou=
rce-id=3D"4239261701" data-linked-resource-version=3D"1" data-linked-resour=
ce-type=3D"attachment" data-linked-resource-default-alias=3D"Screenshot 202=
4-10-28 at 1.04.02=E2=80=AFPM-20241028-201036.png" data-base-url=3D"https:/=
/sharpencx.atlassian.net/wiki" data-linked-resource-content-type=3D"image/p=
ng" data-linked-resource-container-id=3D"3423698949" data-linked-resource-c=
ontainer-version=3D"13" data-media-id=3D"8c4263d6-66f0-4c7c-b569-207416a5da=
e2" data-media-type=3D"file" height=3D"963"></span>
<p></p>
</div>
</div>
</div>
<div class=3D"columnLayout fixed-width" data-layout=3D"fixed-width">
<div class=3D"cell normal" data-type=3D"normal">
<div class=3D"innerCell">
<p></p>
</div>
</div>
</div>
</div>
    </div>
</body>
</html>
